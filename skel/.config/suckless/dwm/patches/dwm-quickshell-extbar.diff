+int
+winisdock(Window w)
+{
+	int di, ret = 0;
+	unsigned long i, nitems, dl;
+	unsigned char *p = NULL;
+	Atom da;
+
+	if (XGetWindowProperty(dpy, w, netatom[NetWMWindowType], 0L, 8L, False,
+		XA_ATOM, &da, &di, &nitems, &dl, &p) == Success && p) {
+		for (i = 0; i < nitems; i++)
+			if (((Atom *)p)[i] == netatom[NetWMWindowTypeDock])
+				ret = 1;
+		XFree(p);
+	}
+	return ret;
+}
+
+int
+extbarremove(Window w)
+{
+	ExtBar *eb, **peb;
+
+	for (peb = &extbars; (eb = *peb); peb = &eb->next)
+		if (eb->win == w) {
+			*peb = eb->next;
+			free(eb);
+			return 1;
+		}
+	return 0;
+}
+
+void
+updateextbars(void)
+{
+	Monitor *m;
+	ExtBar *eb, **peb;
+	XWindowAttributes wa;
+	int format;
+	unsigned long n, extra;
+	unsigned long *strut;
+	Atom real;
+	long top, bottom;
+
+	for (m = mons; m; m = m->next)
+		m->extbartop = m->extbarbot = 0;
+	for (peb = &extbars; (eb = *peb);) {
+		if (!XGetWindowAttributes(dpy, eb->win, &wa)) {
+			*peb = eb->next;
+			free(eb);
+			continue;
+		}
+		/* struts are root-relative: top counts down from y=0,
+		 * bottom counts up from the bottom edge of the X screen */
+		top = bottom = 0;
+		strut = NULL;
+		if (XGetWindowProperty(dpy, eb->win, netatom[NetWMStrutPartial], 0L, 12L,
+			False, XA_CARDINAL, &real, &format, &n, &extra,
+			(unsigned char **)&strut) == Success && strut && n >= 4) {
+			top = strut[2];
+			bottom = strut[3];
+		}
+		if (strut)
+			XFree(strut);
+		if (!top && !bottom) {
+			strut = NULL;
+			if (XGetWindowProperty(dpy, eb->win, netatom[NetWMStrut], 0L, 4L,
+				False, XA_CARDINAL, &real, &format, &n, &extra,
+				(unsigned char **)&strut) == Success && strut && n >= 4) {
+				top = strut[2];
+				bottom = strut[3];
+			}
+			if (strut)
+				XFree(strut);
+		}
+		m = recttomon(wa.x, wa.y, wa.width, wa.height);
+		if (top)
+			m->extbartop = MAX(m->extbartop, (int)top - m->my);
+		if (bottom)
+			m->extbarbot = MAX(m->extbarbot, (int)bottom - (sh - m->my - m->mh));
+		peb = &eb->next;
+	}
+	for (m = mons; m; m = m->next) {
+		updatebarpos(m);
+		arrange(m);
+	}
+}
