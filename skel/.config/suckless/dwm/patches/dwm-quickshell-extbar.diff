+void
+reloadcolors(void)
+{
+	/* re-read Xresources and restyle in place — no re-exec, so the
+	 * selected tags and all pertag state survive a theme change */
+	Client *c;
+	Monitor *m;
+	unsigned int i;
+
+	load_xresources();
+	for (i = 0; i < LENGTH(colors); i++) {
+		drw_scm_free(drw, scheme[i], 3);
+		scheme[i] = drw_scm_create(drw, colors[i], 3);
+	}
+	drw_scm_free(drw, scheme[LENGTH(colors)], 3);
+	scheme[LENGTH(colors)] = drw_scm_create(drw, colors[0], 3);
+	for (m = mons; m; m = m->next)
+		for (c = m->clients; c; c = c->next)
+			XSetWindowBorder(dpy, c->win, scheme[c == selmon->sel
+				? SchemeSel : SchemeNorm][ColBorder].pixel);
+	drawbars();
+}
