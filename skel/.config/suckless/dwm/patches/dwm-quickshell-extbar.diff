+	m->wy += m->extbartop;
+	m->wh -= m->extbartop + m->extbarbot;
 	if (m->showbar) {
 		m->wh = m->wh - vertpad - bh;
 		m->by = m->topbar ? m->wy : m->wy + m->wh + vertpad;
@@ -2654,6 +2893,34 @@ void updatecurrentdesktop(void){
