+
+void updatelayoutprop(void){
+	/* publish the selected monitor's layout (a layouts[] index), gap size,
+	 * mfact (as a percent) and nmaster for the external bar's picker;
+	 * pertag swaps all of these on view changes too, so this rides the
+	 * updatecurrentdesktop heartbeat as well as the individual setters */
+	long data[] = { 0 };
+	unsigned int i;
+	for (i = 0; i < LENGTH(layouts) && layouts[i].symbol; i++)
+		if (selmon->lt[selmon->sellt] == &layouts[i]) {
+			data[0] = i;
+			break;
+		}
+	XChangeProperty(dpy, root, netatom[NetLayout], XA_CARDINAL, 32, PropModeReplace, (unsigned char *)data, 1);
+	data[0] = selmon->gappoh;
+	XChangeProperty(dpy, root, netatom[NetGaps], XA_CARDINAL, 32, PropModeReplace, (unsigned char *)data, 1);
+	data[0] = (long)(selmon->mfact * 100 + 0.5);
+	XChangeProperty(dpy, root, netatom[NetMfact], XA_CARDINAL, 32, PropModeReplace, (unsigned char *)data, 1);
+	data[0] = selmon->nmaster;
+	XChangeProperty(dpy, root, netatom[NetNmaster], XA_CARDINAL, 32, PropModeReplace, (unsigned char *)data, 1);
+	data[0] = selmon->wfsymbol[0] == WFACTIVE;
+	XChangeProperty(dpy, root, netatom[NetFollow], XA_CARDINAL, 32, PropModeReplace, (unsigned char *)data, 1);
 }
 
